# ── direnv + nix-direnv ─────────────────────────────
# Automatically enters the nix develop environment on cd.
# Requires: nix-direnv (https://github.com/nix-community/nix-direnv)
#
# Install:
#   1. Add nix-direnv to your home-manager or nixpkgs config
#   2. Add "use flake" to your ~/.direnvrc (or let nix-direnv handle it)
#   3. Run: direnv allow

if ! has nix_direnv_version 2>/dev/null; then
  # Fallback for plain direnv without nix-direnv
  use flake
else
  # nix-direnv — faster, cached
  nix_direnv_watch_file flake.nix
  nix_direnv_watch_file flake.lock
  nix_direnv_watch_file pyproject.toml
  nix_direnv_watch_file uv.lock
  use flake
fi

# ── GCP credentials (agenix) ────────────────────────
# `gcloud-auth` is a service-account JSON managed by agenix in nixos-config.
# Export it only when the decrypted secret is readable, so machines and CI
# without agenix can still enter the dev shell.
if [ -r /run/agenix/gcloud-auth ]; then
  export GOOGLE_APPLICATION_CREDENTIALS=/run/agenix/gcloud-auth

  # Match the TF_VAR convention used by nixos-config's cloud/gcp stack.
  export TF_VAR_gcp_credentials_file=/run/agenix/gcloud-auth

  # Derive the default project from the key without printing secret material.
  gcp_project=""
  if command -v jq >/dev/null 2>&1; then
    gcp_project=$(jq -r '.project_id // empty' /run/agenix/gcloud-auth 2>/dev/null || true)
  elif command -v python3 >/dev/null 2>&1; then
    gcp_project=$(python3 -c \
      'import json, sys; print(json.load(open(sys.argv[1])).get("project_id", ""))' \
      /run/agenix/gcloud-auth 2>/dev/null || true)
  fi

  if [ -n "$gcp_project" ]; then
    export GOOGLE_PROJECT="$gcp_project"
    export GOOGLE_CLOUD_PROJECT="$gcp_project"
    export CLOUDSDK_CORE_PROJECT="$gcp_project"
    export TF_VAR_project="$gcp_project"
  fi
  unset gcp_project
fi
